#!/usr/bin/env bash
# Pre-push gate: run `make ci` (exactly what ci.yml runs) on the commit being pushed.
# Install once with `make hooks`. Emergency bypass: git push --no-verify.
#
# Checks the COMMIT BEING PUSHED, not just whatever is checked out: `make ci` reads the working
# tree, so the push is refused unless the tree is clean and every pushed ref's local sha is HEAD.
set -euo pipefail

top=$(git rev-parse --show-toplevel)
head_sha=$(git rev-parse HEAD)
cd "$top"

# Scrub git's own env before running checks: a hook inherits GIT_DIR / GIT_INDEX_FILE, and tests
# that call git would otherwise act on THIS repo (commit into it, flip core.bare).
for v in $(git rev-parse --local-env-vars); do unset "$v"; done

zero=0000000000000000000000000000000000000000
pushing=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a remote ref: nothing to check
  pushing=1
  # An annotated tag's sha is the tag OBJECT; peel it to the commit it points at.
  commit_sha=$(git rev-parse --verify --quiet "${local_sha}^{commit}" || echo "$local_sha")
  if [ "$commit_sha" != "$head_sha" ]; then
    echo "pre-push: refusing. '${local_ref}' is ${local_sha:0:12} but HEAD is ${head_sha:0:12};" >&2
    echo "  the gate tests the checked-out tree, not that commit. Run: git switch <branch> && git push" >&2
    exit 1
  fi
done
[ "$pushing" = 1 ] || exit 0   # only deletions (or nothing) pushed

if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: refusing. The working tree is dirty, so 'make ci' would test files that are not" >&2
  echo "  in the commit being pushed. Commit or stash (git stash -u), then push again." >&2
  exit 1
fi

echo "pre-push: running 'make ci' on ${head_sha:0:12}" >&2
# No env var can replace this command: tests put a fake `make` first on PATH instead.
make ci >&2 || { echo "pre-push: gate FAILED; push aborted (emergency bypass: git push --no-verify)" >&2; exit 1; }
